# Copy this file to .env and fill in the values. Never commit .env.
# AWS credentials are NOT stored here: boto3 reads them from `aws configure`.

# --- AWS / S3 ---
AWS_REGION=us-east-1
S3_BUCKET=
S3_FACT_PREFIX=raw/clickstream
S3_DIM_PREFIX=raw/dimensions
S3_COMPRESS=false

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_TOPIC_PREFIX=clickstream
KAFKA_GROUP_ID=s3-writer

# --- Consumer batching (one S3 file per table per flush) ---
BATCH_SIZE=5000
FLUSH_SECONDS=60

# --- Producer (replay of the generated CSVs) ---
GENERATED_CSV_DIR=data/generated_csvs
REPLAY_RATE=200

# --- Automation (docker compose) ---
KAFKA_PARTITIONS=3
# small = 10,000 events (quick check) | full = 10,000,000 events (big: disk, RAM, hours)
GENERATE_SIZE=small
KAGGLE_CSV_DIR=data/kaggle_data
# 0 = consumer runs forever. 30 = consumer finishes 30s after the last message (run-once mode).
IDLE_EXIT_SECONDS=0
